                "D:/Qt/Qt5.12.12/5.12.12/msvc2017_64/include/QtWebEngineCore",
                "D:/Qt/Qt5.12.12/5.12.12/msvc2017_64/include/QtWebEngineWidgets",
                "D:/Qt/Qt5.12.12/5.12.12/msvc2017_64/include/QtPositioning",
                "D:/Qt/Qt5.12.12/5.12.12/msvc2017_64/mkspecs/win32-msvc",

