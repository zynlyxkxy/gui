            // 与构建一致：MSVC 默认的 WIN32/_WINDOWS/UNICODE/_UNICODE，共享模块加的
            // _HAS_STD_BYTE=0，以及 target GUI 在 Debug 下的编译定义
            // （GUI_DEBUG 由 CMake 按 CONFIG 定义，Release 换成 QT_NO_DEBUG）。
            "defines": [
                "WIN32",
                "_WINDOWS",
                "UNICODE",
                "_UNICODE",
                "_HAS_STD_BYTE=0",
                "GUI_DEBUG",
                "QCUSTOMPLOT_USE_LIBRARY",
                "QT_CORE_LIB",
                "QT_GUI_LIB",
                "QT_NETWORK_LIB",
                "QT_WIDGETS_LIB",
                "QT_PRINTSUPPORT_LIB",
                "QT_QML_LIB",
